{
  "version": 2,
  "name": "rankingsb-web",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://www.rankingsb.com"
  },
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": false
  },
  "crons": [
    {
      "path": "/api/synclocal/cron/verify-all",
      "schedule": "0 17 1 * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rankingsb.com"
        }
      ],
      "destination": "https://www.rankingsb.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
